import { LineEdit, VerticalBox, ScrollView, HorizontalBox, ComboBox, Switch } from "std-widgets.slint";
import { SplashWindow } from "splash.slint";

// Re-exported so there is a single compile entry: build.rs compiles this file.
export { SplashWindow }

// ==========================================
// CUSTOM BUTTON COMPONENT (Optimized)
// ==========================================
component DarkButton inherits Rectangle {
    in-out property <string> btn-text: "Button";
    in-out property <bool> btn-enabled: true;
    // Added customizable background colors to replace hardcoded raw Rectangles
    in-out property <color> btn-color: #555555;
    in-out property <color> btn-color-disabled: #333333;
    // The 20px default is sized for the big LAUNCH/CLEAR buttons. The compact
    // buttons on the Advanced rows are ~28px tall, where it does not fit.
    in-out property <length> btn-font-size: 20px;
    callback clicked();

    background: root.btn-enabled ? root.btn-color : root.btn-color-disabled;
    border-radius: 4px;

    Text {
        text: root.btn-text;
        color: root.btn-enabled ? white : #888888;
        font-size: root.btn-font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        enabled: root.btn-enabled;
        clicked => { root.clicked(); }
    }
}

// ==========================================
// FOLDABLE SECTION HEADER
// ==========================================
// A chevron and a title that fold the group below them. The chevron is drawn
// rather than loaded for the same reason DefenderButton's shield is: assets/
// holds screen-match templates, not icons, and a vector needs no bundling.
component FoldHeader inherits Rectangle {
    in property <string> title;
    in-out property <bool> expanded: false;

    height: 30px;
    border-radius: 4px;
    background: touch.has-hover ? #333333 : transparent;

    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 6px;
        spacing: 8px;
        alignment: start;

        Path {
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 12;
            viewbox-height: 12;
            // Points down when open, right when closed. Swapping the commands
            // keeps this off any rotation support for a Path.
            commands: root.expanded ? "M 2 4 L 6 9 L 10 4 Z" : "M 4 2 L 9 6 L 4 10 Z";
            fill: #d4d4d4;
        }

        Text {
            text: root.title;
            color: #d4d4d4;
            font-size: 14px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.expanded = !root.expanded; }
    }
}

// ==========================================
// ADVANCED PATH ROW
// ==========================================
// One overridable value — a Defender screen-match image, one of the programs
// LAUNCH starts, or a window title it searches for: what it is, a picker, and
// the way back to the original.
//
// Empty text means the built-in default, which is why Default is a single
// assignment with no backend round trip — only `browse` needs one.
//
// `show-browse: false` drops the picker for the rows that have nothing to pick:
// a window title is typed, not chosen from the filesystem. Everything else
// about the row is shared, which is the reason this is a flag rather than a
// second component.
//
// Label and field keep the 170px/20px column the rows above use; the buttons
// sit in their own 8px group so the row's natural minimum stays narrow enough
// for the 620px window floor.
component PathRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> placeholder: "Built-in default";
    in property <bool> show-browse: true;
    in-out property <string> path;
    callback browse();

    spacing: 20px;

    Text {
        text: root.label;
        color: #d4d4d4;
        vertical-alignment: center;
        min-width: 170px;
    }

    HorizontalLayout {
        horizontal-stretch: 1;
        spacing: 8px;

        LineEdit {
            text <=> root.path;
            placeholder-text: root.placeholder;
            horizontal-stretch: 1;
            min-width: 100px;
        }

        if (root.show-browse) : DarkButton {
            btn-text: "…";
            btn-font-size: 16px;
            width: 32px;
            height: 28px;
            y: (parent.height - self.height) / 2;
            clicked => { root.browse(); }
        }

        DarkButton {
            btn-text: "Default";
            btn-font-size: 13px;
            width: 72px;
            height: 28px;
            y: (parent.height - self.height) / 2;
            clicked => { root.path = ""; }
        }
    }
}

// ==========================================
// MIDI ACTIVITY LED
// ==========================================
component MidiLed inherits Rectangle {
    in property <bool> lit: false;

    width: 16px;
    height: 16px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #111111;
    background: root.lit ? #3ddc63 : #3a3a3a;

    // Without the fade a single note is one frame long and easy to miss.
    animate background { duration: 120ms; }
}

// ==========================================
// DEFENDER TOGGLE BUTTON
// ==========================================
// The shield is drawn rather than loaded: the assets/defender_*.png files are
// screen-match templates (screenshots of the Defender UI), not icons, and a
// vector needs no file bundling into the packaged build.
component DefenderButton inherits Rectangle {
    in property <bool> active: false;
    in property <bool> btn-enabled: true;
    callback clicked();

    width: 40px;
    height: 30px;
    border-radius: 4px;
    border-width: 1px;
    background: root.active ? #2f3f34 : #333333;
    border-color: root.active ? #3ddc63 : #4a4a4a;

    animate background, border-color { duration: 120ms; }

    Path {
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        // A shield: flat top, shoulders, tapering to a point.
        commands: "M 12 2 L 20.5 5.5 L 20.5 11.5 C 20.5 16.5 16.8 20.7 12 22 C 7.2 20.7 3.5 16.5 3.5 11.5 L 3.5 5.5 Z";
        fill: root.active ? #3ddc63 : #6a6a6a;
        animate fill { duration: 120ms; }
    }

    TouchArea {
        enabled: root.btn-enabled;
        clicked => { root.clicked(); }
    }
}

// ==========================================
// MAIN APPLICATION WINDOW
// ==========================================
export component MainWindow inherits Window {
    title: "Gig Control Center";
    preferred-width: 800px;
    preferred-height: 600px;

    // A floor, so the window cannot be dragged into a size the layout cannot
    // serve. The status row is the binding constraint: two fixed 220px columns
    // either side of the 40px shield is 480px, plus 20px of padding a side, so
    // 520px is the true minimum and this leaves a little slack.
    //
    // Both floors are set by the settings modal, which needs more room than the
    // main screen does. Measured rather than guessed: a settings row cannot go
    // below 170px label + 20px spacing + the dropdown's own minimum, and a
    // ComboBox sizes itself to its longest item — 328px for an output named
    // "Haut-parleur (Realtek(R) Audio)". With the panel's 24px padding a side
    // and a 16px margin, that is ~598px, so 620px leaves a little headroom for
    // a longer device name than any on this machine.
    //
    // Below this the modal could not shrink to fit, so it stayed wider than the
    // window and, being centred, hung off both edges — which is how the labels
    // came to lose their first characters off the left.
    //
    // The height floor works the same way: the modal caps at 520px plus margin,
    // so 560px is enough, and it stays below the 600px the window opens at so a
    // shorter-than-default window is still allowed.
    min-width: 620px;
    min-height: 560px;

    background: #2b2b2b;

    // --- Main State ---
    in-out property <string> launch-text: "LAUNCH GIG RIG";
    in-out property <string> clear-text: "CLEAR DECK";
    in-out property <string> console-text: "";
    in-out property <bool> buttons-enabled: true;
    
    // --- MIDI + Shutdown State ---
    in property <bool> midi-active: false;
    in property <[string]> midi-devices: [];
    in-out property <string> midi-device: "";
    in-out property <bool> shutdown-after-clear: false;
    in-out property <bool> manage-defender: true;
    in property <bool> audio-active: false;
    in property <[string]> audio-devices: [];
    in-out property <string> audio-device: "";

    // --- Modal State ---
    in-out property <bool> show-settings: false;
    in-out property <string> phone-name: "";
    in-out property <string> hotspot-name: "";
    in-out property <string> osc-path: "";

    // --- Advanced: Defender screen-match images ---
    //
    // Collapsed by default, so the modal opens looking as it always did.
    //
    // These four are two-way bound to their fields rather than read at save
    // time like phone/hotspot/OSC above, because three things write them: the
    // field itself, the Browse button (from the backend) and the Default
    // button. Empty means "use the image compiled into the exe", which is what
    // makes Default a one-liner that needs no backend at all.
    //
    // The flip side of a two-way binding is that CANCEL no longer discards an
    // edit for free, so the backend re-seeds these when the modal opens.
    in-out property <bool> advanced-expanded: false;
    in-out property <string> defender-turn-on-image: "";
    in-out property <string> defender-activation-state-image: "";
    in-out property <string> defender-realtime-label-image: "";
    in-out property <string> defender-manage-settings-image: "";

    // --- Advanced: where the programs LAUNCH starts live ---
    // Same empty-means-default rule as the images above. The Open Stage
    // Control default has its version in the folder name, so it goes stale
    // every upgrade — that is what these are mainly for.
    in-out property <string> executable-gig-performer: "";
    in-out property <string> executable-open-stage-control: "";

    // --- Advanced: the window titles the snap step searches for ---
    // The same empty-means-default rule once more. These are matched against a
    // window's title rather than opened, and the Gig Performer one is the gig
    // file's name, so it goes stale whenever a gig file is renamed. No Browse
    // on these rows: there is no file to pick.
    in-out property <string> window-name-open-stage-control: "";
    in-out property <string> window-name-gig-performer: "";

    // --- Advanced: how wide Open Stage Control is when the snap runs ---
    // A percentage of the screen width, empty-means-default like the rest.
    // Only one number because Gig Performer takes the remainder: a second
    // field could be set to a pair that leaves a strip of desktop showing.
    in-out property <string> snap-ratio: "";

    // --- Version ---
    // Pushed from Rust so the label can never disagree with Cargo.toml.
    // See src/version.rs for why it reads V1.0 and not V1.0.0.
    in property <string> app-version;

    // --- Callbacks ---
    callback launch-clicked();
    callback clear-clicked();
    callback save-clicked(string, string, string);
    callback shutdown-toggled(bool);
    callback defender-toggled(bool);
    callback settings-opened();
    // Takes the slot name — "turn-on", "activation-state", "realtime-label",
    // "manage-settings", "gig-performer" or "open-stage-control" — and the
    // backend writes the chosen path back into the matching property above,
    // picking the file filter from the slot. One argument rather than six
    // callbacks, and nothing to return: cancelling has to leave the field
    // alone, which a returned empty string could not express.
    callback browse-for-path(string);

    // ==========================================
    // MAIN UI LAYER
    // ==========================================
    VerticalBox {
        padding: 20px;
        spacing: 15px;

        // 0. Status Row — on the same grid as everything below: MIDI flush
        // left, Defender on the window centre, Shutdown flush right.
        //
        // HorizontalLayout, not HorizontalBox: the latter adds theme padding
        // that insets whatever is nested in it. The outer columns are a fixed,
        // equal width because horizontal-stretch only shares out *surplus*
        // space — with stretch alone the wider Shutdown column stole width and
        // dragged the middle column, and the Defender button, off centre.
        HorizontalLayout {
            height: 36px;

            HorizontalLayout {
                width: 220px;
                alignment: start;
                spacing: 8px;

                MidiLed {
                    lit: root.midi-active;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: "MIDI";
                    color: #d4d4d4;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                horizontal-stretch: 1;
                alignment: center;

                DefenderButton {
                    active: root.manage-defender;
                    btn-enabled: root.buttons-enabled && !root.show-settings;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        root.manage-defender = !root.manage-defender;
                        root.defender-toggled(root.manage-defender);
                    }
                }
            }

            HorizontalLayout {
                width: 220px;
                alignment: end;

                Switch {
                    text: "Shutdown";
                    checked <=> root.shutdown-after-clear;
                    enabled: root.buttons-enabled && !root.show-settings;
                    y: (parent.height - self.height) / 2;
                    toggled => { root.shutdown-toggled(self.checked); }
                }
            }
        }

        // 1. Top Button Frame
        HorizontalLayout {
            spacing: 10px;
            alignment: center;

            DarkButton {
                btn-text: root.clear-text;
                btn-enabled: root.buttons-enabled && !root.show-settings;
                height: 60px;
                min-width: 200px;
                clicked => { root.clear-clicked(); }
            }
            
            // Reused DarkButton instead of raw Rectangle
            DarkButton {
                btn-text: root.launch-text;
                btn-enabled: root.buttons-enabled && !root.show-settings;
                btn-color: #007acc;
                btn-color-disabled: #004c80;
                height: 60px;
                min-width: 200px;
                clicked => { root.launch-clicked(); }
            }
        }

        // 2. Console Output Area
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: #1e1e1e;
            border-radius: 4px;
            border-width: 1px;
            border-color: #555555;
            clip: true;

            ScrollView {
                VerticalLayout {
                    padding: 10px;
                    spacing: 0px;

                    Text {
                        text: root.console-text;
                        font-family: "Consolas";
                        font-size: 14px;
                        color: #d4d4d4;
                        wrap: word-wrap;
                        horizontal-alignment: left;
                    }
                }
            }
        }

        // 3. Bottom Row — audio activity left, Settings right, on the same
        // grid as the console panel above, with the version centred over them.
        //
        // The version is overlaid rather than sat between the two. As a third
        // child of the row it centres in whatever space the other two leave
        // over, and since the Settings button is wider than the AUDIO group
        // that puts it ~27px left of the window's centre line. Drawn on top of
        // the full-width row it centres on the window itself, and stays there
        // as either side changes width.
        Rectangle {
            height: 50px;

            HorizontalLayout {
                HorizontalLayout {
                    horizontal-stretch: 1;
                    alignment: start;
                    spacing: 8px;

                    MidiLed {
                        lit: root.audio-active;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: "AUDIO";
                        color: #d4d4d4;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                }

                DarkButton {
                    btn-text: "⚙ Settings";
                    height: 50px;
                    min-width: 130px;
                    btn-enabled: root.buttons-enabled && !root.show-settings;
                    clicked => {
                        root.settings-opened();
                        root.show-settings = true;
                    }
                }
            }

            // Version and author. Two Text elements rather than one styled
            // run, because the software renderer this app selects flattens
            // StyledText back to plain text — a per-run link colour would
            // simply not draw. The underline is a Rectangle for a related
            // reason: Slint has no text-decoration. Only the word carries a
            // TouchArea, so the Settings button underneath still takes its
            // own clicks through this overlay.
            HorizontalLayout {
                alignment: center;
                spacing: 0px;

                Text {
                    text: root.app-version + " by ";
                    color: #9a9a9a;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: author.preferred-width;
                    height: author.preferred-height + 2px;
                    y: (parent.height - self.height) / 2;

                    author := Text {
                        text: "Merbac";
                        color: touch.has-hover ? #3d9bdc : #007acc;
                        font-size: 12px;
                        y: 0;
                        animate color { duration: 120ms; }
                    }

                    Rectangle {
                        y: author.preferred-height;
                        height: 1px;
                        background: author.color;
                        animate background { duration: 120ms; }
                    }

                    touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Platform.open-url("https://github.com/mercibac/gig-center");
                        }
                    }
                }
            }
        }
    }

    // ==========================================
    // MODAL OVERLAY LAYER
    // ==========================================
    if (root.show-settings) : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000099; // Semi-transparent black dimming

        // Block clicks to main UI
        TouchArea {
            width: 100%;
            height: 100%;
        }

        // Settings box
        //
        // Sized to what the window can spare rather than to a fixed 650x585.
        // Hard-coded, it simply overflowed once the window was narrower than
        // itself: labels lost their first characters off the left edge and the
        // fields ran off the right.
        //
        // x and y are explicit because a size without a position leaves the
        // corner up to Slint, and the centring has to hold at every width.
        Rectangle {
            width: min(650px, parent.width - 32px);
            // Collapsed, this is the 520px the modal has always been. Expanded,
            // it takes what the window can spare instead: at 520px the image
            // rows sat behind a scrollbar while a third of the window's height
            // went unused below the panel.
            //
            // 1240px is measured against the content — ~1075px of rows and
            // notes plus ~165px of title, padding and the button row — and it
            // stays a cap rather than a plain height, so a tall window does not
            // stretch the panel past its own content. A window shorter than
            // that still scrolls, which is what the ScrollView and its gutter
            // are for. It was 920px before the Window names group added a
            // heading, two rows and a note, and 1100px before the Window split
            // group added a heading, one row and another note.
            height: min(root.advanced-expanded ? 1240px : 520px, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            background: #2b2b2b;
            border-radius: 8px;
            border-width: 1px;
            border-color: #444444;
            
            // Drop shadow effect
            drop-shadow-color: #000000;
            drop-shadow-blur: 15px;
            drop-shadow-offset-y: 5px;

            VerticalBox {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: "Configuration Settings";
                    color: white;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                // HorizontalLayout, not HorizontalBox: the latter adds theme
                // padding on top of this spacing, which is what made each row
                // cost ~85px and forced the box to 585px tall. Same reasoning
                // as the status row above.
                //
                // No `alignment: center` on these rows either: it sizes each
                // row to its own content, so a row with a wider field starts
                // further left. Filling the width instead makes the 220px label
                // column a real column, shared by every row.
                //
                // What actually caused the clipping: a `width:` on the panel
                // above does not override the minimum width its content
                // reports, and the widest row's minimum was ~542px — 24px
                // padding + 220px label + 20px spacing + a ComboBox that sizes
                // itself to its longest device name (~278px for "Casque
                // (Realtek(R) Audio)"). So the panel could not shrink to fit a
                // narrow window: it stayed wider, and being centred put its
                // left edge at a negative x, which is why the labels lost their
                // first characters off the left.
                //
                // The label column is 170px rather than 220px, measured: the
                // longest label draws 151px wide, so the rest was waste. That
                // buys 50px back, and the window's min-width covers what is
                // left. Trying to cap the dropdown's own minimum was a dead end
                // — min-width raises a floor, it cannot lower a natural
                // minimum, and a clipping wrapper around it changed nothing.
                // The rows scroll; the panel does not grow. Expanding Advanced
                // adds four rows more than the 520px cap above can show, and
                // raising that cap would put the panel back outside a narrowed
                // window — the very bug the sizing notes above describe. Title
                // and buttons stay outside this, so SAVE is always reachable
                // however far the list runs.
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        // Bound to the viewport rather than left to the
                        // content: inside a ScrollView an unconstrained layout
                        // reports its own natural width, and the rows stop
                        // filling the panel.
                        //
                        // Minus a gutter, because `visible-width` does not
                        // subtract the scrollbar: without it the bar is drawn
                        // straight over the fields as soon as the list
                        // overflows. Measured off a screenshot of that — the
                        // idle bar came out as a 2px line six pixels inside the
                        // field border, so it was painting on the input itself,
                        // which is the hairline that appeared along the rows
                        // with Advanced open and not with it closed. 16px
                        // rather than the ~8px the idle bar needs, because this
                        // style fattens the thumb on hover.
                        //
                        // Reserved in both states on purpose: a gutter that
                        // came and went would shift every row's right edge as
                        // the section folds, trading one inconsistency for
                        // another.
                        width: parent.visible-width - 16px;
                        spacing: 16px;
                        alignment: start;

                        HorizontalLayout {
                            spacing: 20px;
                            Text { text: "Phone Name (KDE Connect):"; color: #d4d4d4; vertical-alignment: center; min-width: 170px; }
                            phone_input := LineEdit { text: root.phone-name; horizontal-stretch: 1; }
                        }

                        HorizontalLayout {
                            spacing: 20px;
                            Text { text: "Hotspot Name (SSID):"; color: #d4d4d4; vertical-alignment: center; min-width: 170px; }
                            hotspot_input := LineEdit { text: root.hotspot-name; horizontal-stretch: 1; }
                        }

                        HorizontalLayout {
                            spacing: 20px;
                            Text { text: "OSC File Path:"; color: #d4d4d4; vertical-alignment: center; min-width: 170px; }
                            osc_input := LineEdit { text: root.osc-path; horizontal-stretch: 1; }
                        }

                        HorizontalLayout {
                            spacing: 20px;
                            Text { text: "MIDI Device:"; color: #d4d4d4; vertical-alignment: center; min-width: 170px; }
                            ComboBox {
                                model: root.midi-devices;
                                current-value: root.midi-device;
                                horizontal-stretch: 1;
                                selected(value) => { root.midi-device = value; }
                            }
                        }

                        HorizontalLayout {
                            spacing: 20px;
                            Text { text: "Audio Output:"; color: #d4d4d4; vertical-alignment: center; min-width: 170px; }
                            ComboBox {
                                model: root.audio-devices;
                                current-value: root.audio-device;
                                horizontal-stretch: 1;
                                selected(value) => { root.audio-device = value; }
                            }
                        }

                        FoldHeader {
                            title: "Advanced";
                            expanded <=> root.advanced-expanded;
                        }

                        // `if`, not `visible`: an un-instantiated subtree costs
                        // the layout nothing, so a collapsed Advanced leaves the
                        // modal exactly as it was before this existed.
                        if (root.advanced-expanded) : VerticalLayout {
                            spacing: 16px;

                            Text {
                                text: "Leave a field empty, or press Default, to use what is built into the app.";
                                color: #9a9a9a;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            Text {
                                text: "Defender images";
                                color: #d4d4d4;
                                font-size: 13px;
                                font-weight: 700;
                            }

                            PathRow {
                                label: "Turn on button image:";
                                placeholder: "Built-in image";
                                path <=> root.defender-turn-on-image;
                                browse => { root.browse-for-path("turn-on"); }
                            }

                            PathRow {
                                label: "Activation state image:";
                                placeholder: "Built-in image";
                                path <=> root.defender-activation-state-image;
                                browse => { root.browse-for-path("activation-state"); }
                            }

                            PathRow {
                                label: "Realtime label image:";
                                placeholder: "Built-in image";
                                path <=> root.defender-realtime-label-image;
                                browse => { root.browse-for-path("realtime-label"); }
                            }

                            PathRow {
                                label: "Manage settings image:";
                                placeholder: "Built-in image";
                                path <=> root.defender-manage-settings-image;
                                browse => { root.browse-for-path("manage-settings"); }
                            }

                            Text {
                                text: "Turning protection on is the one click on Turn on. Turning it off looks for the activation state card, then Manage settings, then clicks a fixed offset below the realtime label — that label is never clicked itself, so crop a replacement like the original.";
                                color: #9a9a9a;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            Text {
                                text: "Programs";
                                color: #d4d4d4;
                                font-size: 13px;
                                font-weight: 700;
                            }

                            PathRow {
                                label: "Gig Performer:";
                                placeholder: "Default install path";
                                path <=> root.executable-gig-performer;
                                browse => { root.browse-for-path("gig-performer"); }
                            }

                            PathRow {
                                label: "Open Stage Control:";
                                placeholder: "Default install path";
                                path <=> root.executable-open-stage-control;
                                browse => { root.browse-for-path("open-stage-control"); }
                            }

                            Text {
                                text: "A path that is no longer there falls back to the built-in one and says so in the console.";
                                color: #9a9a9a;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            Text {
                                text: "Window names";
                                color: #d4d4d4;
                                font-size: 13px;
                                font-weight: 700;
                            }

                            PathRow {
                                label: "Open Stage Control window:";
                                placeholder: "Open Stage Control";
                                show-browse: false;
                                path <=> root.window-name-open-stage-control;
                            }

                            PathRow {
                                label: "Gig Performer window:";
                                placeholder: "Keyboard_Live";
                                show-browse: false;
                                path <=> root.window-name-gig-performer;
                            }

                            Text {
                                text: "What LAUNCH looks for when it snaps the two windows into their shares of the screen. Matched as a case-insensitive part of the title bar, and the first visible window that matches wins — so the Gig Performer one is usually the name of the gig file, which is what it shows once the file has loaded.";
                                color: #9a9a9a;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            Text {
                                text: "Window split";
                                color: #d4d4d4;
                                font-size: 13px;
                                font-weight: 700;
                            }

                            PathRow {
                                label: "Open Stage Control width:";
                                placeholder: "29%";
                                show-browse: false;
                                path <=> root.snap-ratio;
                            }

                            Text {
                                text: "How much of the screen width Open Stage Control gets when LAUNCH snaps the two windows. Gig Performer takes the rest, so this is the only number to set. Anything outside 10 to 90 is pulled back to the nearest end, and the console says which width it used.";
                                color: #9a9a9a;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                HorizontalBox {
                    alignment: center;
                    padding-top: 10px;
                    spacing: 15px;
                    
                    DarkButton {
                        btn-text: "CANCEL";
                        min-width: 170px;
                        height: 40px;
                        btn-color: #555555;
                        clicked => { root.show-settings = false; }
                    }

                    // Reused DarkButton for Save
                    DarkButton {
                        btn-text: "SAVE SETTINGS";
                        btn-color: #007acc;
                        btn-color-disabled: #004c80;
                        min-width: 170px;
                        height: 40px;
                        clicked => {
                            root.save-clicked(phone_input.text, hotspot_input.text, osc_input.text);
                        }
                    }
                }
            }
        }
    }
}
